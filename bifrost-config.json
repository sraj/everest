{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": {
    "enabled": false
  },
  "providers": {
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key",
          "value": {
            "from_env": true,
            "env_var": "OPENROUTER_API_KEY"
          },
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  }
}
