{
  "providers": {
    "opencode": {
      "keys": [
        {
          "name": "opencode-go-key",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.opencode.ai/v1"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": false
        }
      }
    }
  }
}
