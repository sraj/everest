# Application
APP_NAME=everest
PORT=8080
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/everest?sslmode=disable

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ChromaDB (Vector Database)
CHROMA_ENDPOINT=http://localhost:8000
CHROMA_COLLECTION=everest_documents

# Bifrost AI Gateway (shared by tagger + embeddings)
BIFROST_ENDPOINT=http://localhost:8081

# AI Tagging
AI_TAGGER_ENABLED=false
AI_TAGGER_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# AI Embeddings
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
