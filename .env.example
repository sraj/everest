# Application
APP_NAME=everest
PORT=8080
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/everest?sslmode=disable

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# Zitadel (Authentication — BFF pattern)
# The API server handles OIDC code flow. SPA never sees tokens.
# Set ZITADEL_CLIENT_ID to enable auth, leave empty to disable.
ZITADEL_ISSUER=http://localhost:8082
ZITADEL_CLIENT_ID=<created-in-zitadel-console>
# ZITADEL_REDIRECT_URI is the API callback (not the SPA).
# In Zitadel console, add this exact URL as a redirect URI.
ZITADEL_REDIRECT_URI=http://localhost:8080/auth/callback
# ZITADEL_POST_LOGOUT_URI is where the browser lands after logout.
ZITADEL_POST_LOGOUT_URI=http://localhost:5173
# ZITADEL_SESSION_SECRET is the HMAC key for session cookies.
# Generate: openssl rand -base64 32
ZITADEL_SESSION_SECRET=
